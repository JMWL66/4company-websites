---
---
<section id="contact" class="py-24 px-6 bg-orange-50">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 fade-up">
      <span class="section-label mb-3 block">CONTACT</span>
      <h2 class="text-3xl md:text-4xl font-black text-navy mb-4">無料相談・お問い合わせ</h2>
      <p class="text-gray-600 text-sm">まずはお気軽にご相談ください。初回相談は無料です。</p>
    </div>

    <form class="fade-up bg-white rounded-xl p-8 shadow-sm border border-orange/10 space-y-5"
      action="mailto:jc.ceo.yamaguchi@gmail.com" method="get" enctype="text/plain">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-navy text-xs font-semibold mb-2">会社名</label>
          <input type="text" name="company"
            class="w-full border border-gray-200 rounded px-4 py-3 text-sm focus:outline-none focus:border-orange transition-colors"
            placeholder="株式会社〇〇" />
        </div>
        <div>
          <label class="block text-navy text-xs font-semibold mb-2">お名前 *</label>
          <input type="text" name="name" required
            class="w-full border border-gray-200 rounded px-4 py-3 text-sm focus:outline-none focus:border-orange transition-colors"
            placeholder="山田 太郎" />
        </div>
      </div>
      <div>
        <label class="block text-navy text-xs font-semibold mb-2">メールアドレス *</label>
        <input type="email" name="email" required
          class="w-full border border-gray-200 rounded px-4 py-3 text-sm focus:outline-none focus:border-orange transition-colors"
          placeholder="example@company.com" />
      </div>
      <div>
        <label class="block text-navy text-xs font-semibold mb-2">ご相談内容 *</label>
        <textarea name="body" rows="5" required
          class="w-full border border-gray-200 rounded px-4 py-3 text-sm focus:outline-none focus:border-orange transition-colors resize-none"
          placeholder="経営課題・ご相談内容をご記入ください"></textarea>
      </div>
      <button type="submit" class="btn-orange w-full py-4 text-sm font-bold rounded">
        無料相談を申し込む →
      </button>
      <p class="text-center text-gray-400 text-xs">
        メール：<a href="mailto:jc.ceo.yamaguchi@gmail.com" class="text-orange hover:underline">jc.ceo.yamaguchi@gmail.com</a>
      </p>
    </form>
  </div>
</section>
