      <span class="text-white/40 text-xs">株式会社JCコンサルティング</span>
    </div>
    <nav class="flex gap-6">
      {[['サービス','#services'],['強み','#strengths'],['会社概要','#about'],['お問い合わせ','#contact']].map(([label,href]) => (
