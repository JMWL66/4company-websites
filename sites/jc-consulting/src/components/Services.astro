---
const services = [
  {
    num: '01',
    title: '経営戦略コンサルティング',
    en: 'Management Strategy',
    desc: '市場分析・競合調査・中長期経営計画の策定など、経営のビジョンを実現するための戦略立案を包括的に支援します。',
    color: 'bg-orange/10 text-orange',
  },
  {
    num: '02',
    title: '組織・人材コンサルティング',
    en: 'HR & Organization',
    desc: '組織設計、人材育成制度の整備、採用戦略の構築まで、企業の「人」に関わる課題を多角的にサポートします。',
    color: 'bg-navy/10 text-navy',
  },
  {
    num: '03',
    title: '業務プロセス改善',
    en: 'Process Improvement',
    desc: '現場の業務フロー分析から改善施策の実行まで、生産性向上と業務効率化を実現するコンサルティングです。',
    color: 'bg-orange/10 text-orange',
  },
  {
    num: '04',
    title: 'ITコンサルティング',
    en: 'IT Consulting',
    desc: 'DX推進・基幹システム導入・デジタル化戦略の設計まで、テクノロジーを活用した事業変革を支援します。',
    color: 'bg-navy/10 text-navy',
  },
  {
    num: '05',
    title: 'マーケティング支援',
    en: 'Marketing Support',
    desc: 'ブランド戦略・デジタルマーケティング・顧客獲得施策など、売上・認知拡大のための総合的な支援を行います。',
    color: 'bg-orange/10 text-orange',
  },
  {
    num: '06',
    title: '財務・資金調達支援',
    en: 'Finance & Fundraising',
    desc: '財務分析・事業計画書作成・投資家向けピッチ資料作成まで、資金調達・財務改善を強力にサポートします。',
    color: 'bg-navy/10 text-navy',
  },
];
---
<section id="services" class="py-24 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 fade-up">
      <span class="section-label mb-3 block">SERVICES</span>
      <h2 class="text-3xl md:text-4xl font-black text-navy mb-4">サービス一覧</h2>
      <p class="text-gray-500 text-sm max-w-xl mx-auto">
        経営の多様な課題に対応する6つのコンサルティングサービスを提供しています。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s, i) => (
        <div
          class="fade-up bg-white rounded-lg p-8 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class={`inline-block px-3 py-1 rounded text-xs font-bold mb-4 ${s.color}`}>
            {s.num}
          </div>
          <h3 class="text-navy font-bold text-base mb-1">{s.title}</h3>
          <p class="text-orange text-xs tracking-wide mb-4">{s.en}</p>
          <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
