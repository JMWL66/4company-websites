---
const services = [
  {
    num: '01',
    title: '経営戦略コンサルティング',
    en: 'Management Strategy',
    desc: '市場分析・競合調査・中長期経営計画の策定など、経営のビジョンを実現するための戦略立案を包括的に支援します。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>`,
  },
  {
    num: '02',
    title: '組織・人材コンサルティング',
    en: 'HR & Organization',
    desc: '組織設計、人材育成制度の整備、採用戦略の構築まで、企業の「人」に関わる課題を多角的にサポートします。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>`,
  },
  {
    num: '03',
    title: '業務プロセス改善',
    en: 'Process Improvement',
    desc: '現場の業務フロー分析から改善施策の実行まで、生産性向上と業務効率化を実現するコンサルティングです。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/>`,
  },
  {
    num: '04',
    title: 'ITコンサルティング',
    en: 'IT Consulting',
    desc: 'DX推進・基幹システム導入・デジタル化戦略の設計まで、テクノロジーを活用した事業変革を支援します。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>`,
  },
  {
    num: '05',
    title: 'マーケティング支援',
    en: 'Marketing Support',
    desc: 'ブランド戦略・デジタルマーケティング・顧客獲得施策など、売上・認知拡大のための総合的な支援を行います。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46"/>`,
  },
  {
    num: '06',
    title: '財務・資金調達支援',
    en: 'Finance & Fundraising',
    desc: '財務分析・事業計画書作成・投資家向けピッチ資料作成まで、資金調達・財務改善を強力にサポートします。',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.281m5.94 2.28l-2.28 5.941"/>`,
  },
];
---
<section id="services" class="relative py-32 px-6 overflow-hidden">
  <!-- subtle grid -->
  <div class="absolute inset-0 border-grid-fine mask-fade" aria-hidden="true"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full opacity-30"
       style="background: radial-gradient(circle, rgba(245,130,31,0.12) 0%, transparent 70%); filter: blur(80px);" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto">
    <div class="max-w-2xl mb-20 fade-up">
      <span class="section-label mb-5 block">SERVICES / 提供業務</span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
        <span class="gradient-text-cool">経営課題に応える</span><br/>
        <span class="gradient-text">6つのソリューション。</span>
      </h2>
      <p class="text-white/50 text-base leading-relaxed">
        戦略・組織・IT・財務まで、企業の成長フェーズに合わせた包括的なコンサルティングを提供します。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((s, i) => (
        <div
          class="fade-up glass-card p-8 group relative overflow-hidden transition-all duration-500 hover:-translate-y-1"
          style={`transition-delay: ${i * 70}ms`}
        >
          <!-- hover gradient -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
               style="background: radial-gradient(circle at top right, rgba(245,130,31,0.12), transparent 60%);"></div>

          <div class="relative">
            <div class="flex items-start justify-between mb-8">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center text-orange transition-all duration-300 group-hover:scale-110"
                   style="background: rgba(245,130,31,0.1); border: 1px solid rgba(245,130,31,0.2);">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <Fragment set:html={s.icon} />
                </svg>
              </div>
              <span class="font-mono-tech text-white/20 text-xs tracking-widest">{s.num}</span>
            </div>

            <h3 class="font-display text-white font-semibold text-xl mb-1.5">{s.title}</h3>
            <p class="font-mono-tech text-orange text-[10px] tracking-[0.2em] uppercase mb-5">{s.en}</p>
            <p class="text-white/50 text-sm leading-relaxed">{s.desc}</p>

            <div class="mt-6 pt-5 flex items-center gap-2 text-orange/0 group-hover:text-orange transition-all duration-300"
                 style="border-top: 1px solid rgba(255,255,255,0.06);">
              <span class="font-mono-tech text-[10px] tracking-widest">LEARN MORE</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
