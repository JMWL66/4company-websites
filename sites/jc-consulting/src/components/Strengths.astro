---
const strengths = [
  {
    num: '01',
    iconHtml: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>`,
    title: '本質的な課題解決',
    en: 'Root Cause Analysis',
    desc: '表面的な症状ではなく、経営課題の根本原因を特定し、データドリブンに持続可能な解決策を設計します。',
  },
  {
    num: '02',
    iconHtml: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
    title: 'スピードと柔軟性',
    en: 'Agile & Flexible',
    desc: '大手ファームにはない機動力と柔軟な対応で、最短ルートで成果へ到達することにコミットします。',
  },
  {
    num: '03',
    iconHtml: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>`,
    title: '伴走型サポート',
    en: 'End-to-End Partner',
    desc: '提案で終わらせず、実行・定着フェーズまで寄り添い、クライアントと共に成果を実現します。',
  },
];
---
<section id="strengths" class="relative py-32 px-6 overflow-hidden">
  <!-- ambient glow -->
  <div class="absolute top-0 left-1/4 w-[500px] h-[500px] rounded-full"
       style="background: radial-gradient(circle, rgba(245,130,31,0.15) 0%, transparent 70%); filter: blur(80px);" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full"
       style="background: radial-gradient(circle, rgba(56,189,248,0.1) 0%, transparent 70%); filter: blur(80px);" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto">
    <div class="text-center mb-20 fade-up">
      <span class="section-label mb-5 inline-flex">WHY JC / 選ばれる理由</span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
        <span class="gradient-text-cool">差別化を支える、</span><br/>
        <span class="gradient-text">3つのコア・バリュー。</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {strengths.map((s, i) => (
        <div
          class="fade-up glass-card p-10 group relative overflow-hidden hover:-translate-y-2 transition-all duration-500"
          style={`transition-delay: ${i * 120}ms`}
        >
          <!-- big number watermark -->
          <span class="absolute -top-6 -right-2 font-display text-[10rem] font-black leading-none pointer-events-none select-none"
                style="color: rgba(245,130,31,0.04);">{s.num}</span>

          <div class="relative">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center text-orange mb-8 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3"
                 style="background: linear-gradient(135deg, rgba(245,130,31,0.15), rgba(245,130,31,0.05)); border: 1px solid rgba(245,130,31,0.25);">
              <Fragment set:html={s.iconHtml} />
            </div>

            <p class="font-mono-tech text-orange/70 text-[10px] tracking-[0.3em] mb-2">{s.en}</p>
            <h3 class="font-display text-white font-bold text-2xl mb-4">{s.title}</h3>
            <p class="text-white/55 text-sm leading-relaxed">{s.desc}</p>

            <div class="mt-8 h-px w-12 bg-gradient-to-r from-orange to-transparent group-hover:w-full transition-all duration-700"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
