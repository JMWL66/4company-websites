---
const strengths = [
  {
    iconHtml: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>`,
    title: '本質的な課題解決',
    desc: '表面的な症状ではなく、経営課題の根本原因を特定し、持続可能な解決策を提供します。',
  },
  {
    iconHtml: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
    title: 'スピードと柔軟性',
    desc: '大手ファームにはない機動力と柔軟な対応で、スピーディーに成果を出すことを重視します。',
  },
  {
    iconHtml: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>`,
    title: '伴走型サポート',
    desc: '提案で終わらず、実行フェーズまで寄り添い、クライアントと共に成果を実現します。',
  },
];
---
<section id="strengths" class="py-24 px-6 bg-navy">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 fade-up">
      <span class="text-orange text-xs tracking-widest font-medium uppercase mb-3 block">WHY JC</span>
      <h2 class="text-3xl md:text-4xl font-black text-white mb-4">JCコンサルティングの強み</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {strengths.map((s, i) => (
        <div
          class="fade-up text-center p-8 rounded-lg"
          style={`background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); transition-delay: ${i * 100}ms`}
        >
          <div class="flex justify-center mb-4 text-orange">
            <Fragment set:html={s.iconHtml} />
          </div>
          <h3 class="text-white font-bold text-lg mb-3">{s.title}</h3>
          <p class="text-white/50 text-sm leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
