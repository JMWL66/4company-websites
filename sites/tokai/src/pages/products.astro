---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jinko = [
  {
    name: '紅土水沈香 線香',
    sub: 'Red Earth Agarwood Stick',
    spec: '10g × 210mm ＋ 銅製香立て',
    desc: '天然高油老料を使用した高級線香。消臭・アロマ効果に優れ、室内空間を上品に演出します。',
    img: '/products/jinko-1.png',
  },
  {
    name: 'ウード沈香 精美ギフトセット',
    sub: 'Oud Agarwood Gift Set',
    spec: '2筒×10g×210mm ＋ 木製香立て',
    desc: '中式伝統天然香の精美ギフトセット。贈り物として最適な、長時間持続する深い香り。',
    img: '/products/jinko-2.png',
  },
  {
    name: '崖庄沈香 線香セット',
    sub: 'Cliff Agarwood Stick Set',
    spec: '210mm 線香 ＋ 銅製香炉',
    desc: '上質な崖庄産沈香。伝統的な香文化を尊重しながら、現代のライフスタイルにも調和します。',
    img: '/products/jinko-3.png',
  },
  {
    name: '芽庄沈香 携帯用',
    sub: 'Nha Trang Agarwood Portable',
    spec: '携帯用 5g ＋ 銅製香立て',
    desc: 'ベトナム・ニャチャン産の貴重な沈香を使用した携帯用アロマ。どこでも気軽に天然香を楽しめます。',
    img: '/products/jinko-4.png',
  },
  {
    name: '芽莊祥雲 天然盤香',
    sub: 'Nha Trang Coil Incense',
    spec: '12枚（1枚ずつ個別包装）',
    desc: 'ニャチャン産の無接着剤純天然盤香。渦巻き型の優雅な形で、空間をゆっくりと香りで満たします。',
    img: '/products/jinko-5.png',
  },
  {
    name: 'ウード沈香 天然盤香セット',
    sub: 'Oud Agarwood Coil Gift Set',
    spec: '2缶×15枚 ＋ 銅製香炉',
    desc: '中式伝統の天然盤香。ゆっくりと燃え広がる香りで、心身をリラックスさせるアロマギフトセット。',
    img: '/products/jinko-6.png',
  },
];

const marbleTypes = [
  { name: 'ヒルトングレー', sub: 'Hilton Grey', desc: '上品なグレートーンに繊細な白い筋が走る、モダンインテリアに最適な大理石。' },
  { name: 'インクブルー', sub: 'Ink Blue', desc: '深みのあるブルーとゴールドの流れが美しい、高級感あふれる希少石材。' },
  { name: 'スノーマウンテンブルー', sub: 'Snow Mountain Blue', desc: '純白の地に淡いブルーの霞がかかったような、清潔感と格調を兼ね備えた大理石。' },
  { name: '水墨丹青', sub: 'Ink Painting', desc: '水墨画を思わせるモノクロームの模様が個性的。アートとしても映える高品質石材。' },
  { name: 'ドリス', sub: 'Doris', desc: '温かみのあるベージュ系のトーンに優雅な紋様。リビング・浴室など幅広い用途に対応。' },
  { name: '白玉', sub: 'White Jade', desc: '乳白色の透明感と滑らかな質感が特徴。玉のような光沢を持つ純粋さと優美さ。' },
];

const furniture = [
  { category: 'ソファ', items: ['オフィスソファ', 'リビングソファ', 'イタリアソファ'] },
  { category: 'テーブル', items: ['オフィステーブル', 'ダイニングテーブル', 'リビングテーブル'] },
  { category: '椅子', items: ['蝶々椅子', '毛虫椅子'] },
  { category: 'ベッド', items: ['古典ベッド', 'イタリアベッド'] },
];
---
<Layout title="製品紹介 | 東海株式会社" description="東海株式会社の製品ラインナップ。沈香・大理石・家具など、厳選した高品質商品をご紹介します。">
  <Header />
  <main>

    <!-- Page Hero -->
    <section class="relative h-72 md:h-96 flex items-end overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1600&q=80&auto=format&fit=crop"
          alt="Products"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(5,5,5,0.95) 0%, rgba(5,5,5,0.5) 60%, rgba(5,5,5,0.2) 100%);"></div>
      </div>
      <div class="relative z-10 max-w-6xl mx-auto px-6 pb-14 w-full">
        <p class="section-label mb-3">PRODUCTS</p>
        <h1 class="font-serif text-3xl md:text-5xl font-light text-white mb-3">製品紹介</h1>
        <span class="gold-line block w-12"></span>
      </div>
    </section>

    <!-- ====== 沈香 ====== -->
    <section id="jinko" class="py-24 px-6 bg-obsidian marble-bg">
      <div class="max-w-6xl mx-auto">

        <!-- Section intro -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
          <div class="fade-up">
            <p class="section-label mb-4">AGARWOOD</p>
            <h2 class="font-serif text-3xl md:text-4xl font-light text-white mb-4">沈香</h2>
            <span class="gold-line block w-12 mb-6"></span>
            <p class="text-white/50 text-sm font-sans font-light leading-relaxed">
              上質な沈香を厳選し、香道文化や心身のリラクゼーションに適した商品を提供します。
              天然の香木が持つ奥深い香りと上品な質感を大切にし、日常生活に安らぎと豊かさをもたらします。
              伝統的な香文化を尊重しながら、現代のライフスタイルにも調和する商品をご提案します。
            </p>
          </div>
          <div class="fade-up rounded-lg overflow-hidden h-56">
            <img
              src="/products/jinko-3.png"
              alt="沈香"
              class="w-full h-full object-contain bg-white/[0.03]"
            />
          </div>
        </div>

        <!-- Product grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
          {jinko.map((p, i) => (
            <div
              class="fade-up rounded-lg overflow-hidden group"
              style={`transition-delay: ${i * 70}ms`}
            >
              <!-- Product image -->
              <div class="bg-white/[0.04] flex items-center justify-center p-6 h-52 relative overflow-hidden"
                style="border: 1px solid rgba(201,168,76,0.12); border-bottom: none;">
                <img
                  src={p.img}
                  alt={p.name}
                  class="h-full w-full object-contain group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <!-- Product info -->
              <div class="p-4" style="background: rgba(201,168,76,0.04); border: 1px solid rgba(201,168,76,0.12); border-top: none;">
                <h3 class="text-white text-xs font-sans font-medium leading-snug mb-0.5">{p.name}</h3>
                <p class="text-gold/50 text-[10px] tracking-wider mb-2">{p.sub}</p>
                <p class="text-white/30 text-[10px] font-mono mb-2">{p.spec}</p>
                <p class="text-white/40 text-[10px] font-sans font-light leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== 大理石 ====== -->
    <section id="marble" class="py-24 px-6 bg-obsidian-800">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
          <div class="fade-up">
            <p class="section-label mb-4">MARBLE</p>
            <h2 class="font-serif text-3xl md:text-4xl font-light text-white mb-4">大理石</h2>
            <span class="gold-line block w-12 mb-6"></span>
            <p class="text-white/50 text-sm font-sans font-light leading-relaxed">
              美しい大理石を厳選し、建築・インテリアプロジェクトに最適な材料を提供します。
              天然石の美しさと耐久性を兼ね備えた商品をお届けします。
              サンプル請求・カスタムカットにも対応しております。
            </p>
          </div>
          <div class="fade-up rounded-lg overflow-hidden h-56">
            <img
              src="/products/marble-factory.png"
              alt="大理石工場"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Marble types grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-gold/10">
          {marbleTypes.map((m, i) => (
            <div
              class="fade-up bg-obsidian-800 p-6 hover:bg-obsidian-700 transition-colors duration-300 group"
              style={`transition-delay: ${i * 60}ms`}
            >
              <div class="w-8 h-1 bg-gold/30 mb-4 group-hover:bg-gold/70 transition-colors"></div>
              <h3 class="text-white text-sm font-sans font-medium mb-0.5">{m.name}</h3>
              <p class="text-gold/50 text-xs tracking-wider mb-3">{m.sub}</p>
              <p class="text-white/40 text-xs font-sans font-light leading-relaxed">{m.desc}</p>
            </div>
          ))}
        </div>

        <p class="text-white/25 text-xs text-center mt-8 font-sans">
          ※ 上記は一部ラインナップです。その他の品種・サイズについてはお問い合わせください。
        </p>
      </div>
    </section>

    <!-- ====== 家具（準備中）====== -->
    <section id="furniture" class="py-24 px-6 bg-obsidian marble-bg">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-12">
          <div class="fade-up">
            <p class="section-label mb-4">FURNITURE</p>
            <h2 class="font-serif text-3xl md:text-4xl font-light text-white mb-2">
              家具事業
            </h2>
            <p class="text-gold/50 text-xs tracking-widest mb-4 font-sans">準備中 / COMING SOON</p>
            <span class="gold-line block w-12 mb-6"></span>
            <p class="text-white/50 text-sm font-sans font-light leading-relaxed">
              高品質な家具を世界各国から厳選し、日本の住宅文化に合った商品をお届けします。
              伝統的な職人技から現代的なデザインまで、幅広いニーズにお応えします。
            </p>
          </div>
          <div class="fade-up rounded-lg overflow-hidden h-64">
            <img
              src="/products/furniture.jpg"
              alt="家具"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {furniture.map((cat, i) => (
            <div
              class="fade-up p-5 rounded-lg"
              style={`background: rgba(201,168,76,0.04); border: 1px solid rgba(201,168,76,0.12); transition-delay: ${i * 60}ms`}
            >
              <h3 class="text-gold/70 text-xs tracking-wider mb-3 font-sans font-medium">{cat.category}</h3>
              <ul class="space-y-1.5">
                {cat.items.map(item => (
                  <li class="text-white/40 text-xs font-sans font-light flex items-center gap-2">
                    <span class="w-1 h-1 rounded-full bg-gold/30 flex-shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-6 bg-obsidian-800 text-center">
      <div class="max-w-xl mx-auto fade-up">
        <p class="section-label mb-4">CONTACT</p>
        <h2 class="font-serif text-2xl md:text-3xl font-light text-white mb-4">
          製品・仕入れについてのご相談
        </h2>
        <span class="gold-line block w-12 mx-auto mb-6"></span>
        <p class="text-white/40 text-sm font-sans font-light mb-8">
          サンプル請求・価格見積もり・カスタムオーダーなど、<br class="hidden sm:block"/>
          お気軽にお問い合わせください。
        </p>
        <a href="/#contact" class="btn-gold-filled inline-block">お問い合わせ</a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
