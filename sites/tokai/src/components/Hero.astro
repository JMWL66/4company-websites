---
---
<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden marble-bg">
  <!-- Background grid lines -->
  <div class="absolute inset-0 opacity-10" aria-hidden="true"
    style="background-image: linear-gradient(rgba(201,168,76,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.3) 1px, transparent 1px); background-size: 80px 80px;">
  </div>

  <!-- Glow orb -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-5"
    style="background: radial-gradient(circle, #C9A84C 0%, transparent 70%);" aria-hidden="true">
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Logo mark -->
    <div class="flex justify-center mb-10">
      <img src="/logo.png" alt="東海株式会社" class="h-24 w-auto opacity-90" />
    </div>

    <!-- Eyebrow -->
    <p class="section-label mb-6">TOKAI Co., Ltd. — Est. 2020</p>

    <!-- Main headline -->
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light leading-tight mb-6">
      <span class="text-gradient-gold">ビジョンを、</span>
      <br />
      <span class="text-white">現実に。</span>
    </h1>

    <span class="gold-line block w-16 mx-auto mb-8"></span>

    <p class="text-white/50 text-sm sm:text-base font-sans font-light leading-relaxed max-w-xl mx-auto mb-12">
      東海株式会社は、常に時代の先を見据えた事業展開により、<br class="hidden sm:block" />
      持続可能な価値創造を実現します。
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#services" class="btn-gold">事業内容を見る</a>
      <a href="#contact" class="btn-gold-filled">お問い合わせ</a>
    </div>

    <!-- 3 pillars -->
    <div class="mt-16 grid grid-cols-3 gap-8 max-w-lg mx-auto border-t border-gold/15 pt-10">
      {[
        { ja: '誠実', en: 'Integrity' },
        { ja: '革新', en: 'Innovation' },
        { ja: '信頼', en: 'Trust' },
      ].map((v) => (
        <div class="text-center">
          <p class="text-gradient-gold text-xl font-serif mb-1">{v.ja}</p>
          <p class="text-white/30 text-xs tracking-wider">{v.en}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-gold text-[10px] tracking-widest">SCROLL</span>
    <div class="w-px h-12 bg-gradient-to-b from-gold to-transparent"></div>
  </div>
</section>
