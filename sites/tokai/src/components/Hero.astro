---
---
<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=1920&q=85&auto=format&fit=crop"
      alt="Premium Architecture"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(160deg, rgba(5,5,5,0.88) 0%, rgba(10,10,10,0.75) 50%, rgba(0,0,0,0.92) 100%);"></div>
  </div>

  <!-- Gold grid lines -->
  <div class="absolute inset-0 z-[1] opacity-[0.07]" aria-hidden="true"
    style="background-image: linear-gradient(rgba(201,168,76,1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,1) 1px, transparent 1px); background-size: 80px 80px;">
  </div>

  <!-- Gold glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full z-[1] pointer-events-none"
    style="background: radial-gradient(circle, rgba(201,168,76,0.07) 0%, transparent 65%);" aria-hidden="true"></div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Logo -->
    <div class="flex justify-center mb-10">
      <div class="p-4 rounded-2xl" style="background: rgba(201,168,76,0.06); border: 1px solid rgba(201,168,76,0.15);">
        <img src="/logo.png" alt="東海株式会社" class="h-20 w-auto opacity-90" />
      </div>
    </div>

    <!-- Label -->
    <p class="section-label mb-6">TOKAI Co., Ltd. — Est. 2020</p>

    <!-- Headline -->
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light leading-tight mb-6">
      <span class="text-gradient-gold">ビジョンを、</span>
      <br />
      <span class="text-white">現実に。</span>
    </h1>

    <span class="gold-line block w-20 mx-auto mb-8"></span>

    <p class="text-white/50 text-base sm:text-lg font-sans font-light leading-relaxed max-w-xl mx-auto mb-12">
      東海株式会社は、常に時代の先を見据えた事業展開により、<br class="hidden sm:block" />
      持続可能な価値創造を実現します。
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#services" class="btn-gold">事業内容を見る</a>
      <a href="#contact" class="btn-gold-filled">お問い合わせ</a>
    </div>

    <!-- 3 pillars -->
    <div class="mt-16 grid grid-cols-3 gap-8 max-w-lg mx-auto border-t border-gold/15 pt-10">
      {[
        { ja: '誠実', en: 'Integrity' },
        { ja: '革新', en: 'Innovation' },
        { ja: '信頼', en: 'Trust' },
      ].map((v) => (
        <div class="text-center">
          <p class="text-gradient-gold text-xl font-serif mb-1">{v.ja}</p>
          <p class="text-white/30 text-xs tracking-wider">{v.en}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-gold text-[10px] tracking-widest">SCROLL</span>
    <div class="w-px h-12 bg-gradient-to-b from-gold to-transparent"></div>
  </div>
</section>
