---
---
<section id="about" class="py-28 px-6 bg-obsidian marble-bg">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="mb-20 fade-up">
      <p class="section-label mb-4">ABOUT US</p>
      <h2 class="font-serif text-3xl md:text-4xl font-light text-white mb-4">会社概要</h2>
      <span class="gold-line block w-12"></span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: image + CEO info -->
      <div class="fade-up space-y-6">
        <!-- Office image -->
        <div class="relative rounded-lg overflow-hidden h-64">
          <img
            src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&q=80&auto=format&fit=crop"
            alt="Office"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 flex flex-col justify-end p-6"
            style="background: linear-gradient(to top, rgba(5,5,5,0.8), transparent);">
            <p class="text-gold/60 text-xs tracking-widest mb-1">TOKAI Co., Ltd.</p>
            <p class="text-white text-sm font-sans">東京都豊島区東池袋</p>
          </div>
          <div class="absolute inset-0 border border-gold/10 rounded-lg pointer-events-none"></div>
        </div>

        <!-- CEO card -->
        <div class="p-6 rounded-lg" style="background: rgba(201,168,76,0.05); border: 1px solid rgba(201,168,76,0.15);">
          <p class="text-white/30 text-xs tracking-wider mb-2">代表取締役</p>
          <p class="text-white font-serif text-2xl mb-0.5">山口 結愛</p>
          <p class="text-gold/60 text-xs tracking-widest mb-4">YAMAGUCHI YUINA</p>
          <p class="text-white/40 text-sm font-sans font-light leading-relaxed">
            総合商社・コンサルティング・不動産事業を軸に、誠実さと革新で持続的な価値創造を追求しています。
          </p>
        </div>
      </div>

      <!-- Right: Company info table -->
      <div class="fade-up">
        <p class="section-label mb-6">COMPANY INFO</p>
        <table class="w-full text-sm font-sans">
          <tbody>
            {[
              { label: '会社名', value: '東海株式会社' },
              { label: '代表取締役', value: '山口 結愛' },
              { label: '設立', value: '—' },
              { label: '所在地', value: '〒170-0013\n東京都豊島区東池袋1丁目31番17号\nドミール池袋606' },
              { label: '電話番号', value: '03-6681-9915' },
              { label: 'メール', value: 'info@tokaikk.jp' },
              { label: '事業内容', value: '総合商社・コンサルティング・投資・不動産' },
            ].map((row) => (
              <tr class="border-b border-white/5 group hover:bg-white/[0.02] transition-colors">
                <td class="py-4 pr-6 text-gold/60 text-xs tracking-wider whitespace-nowrap w-32">{row.label}</td>
                <td class="py-4 text-white/60 font-light leading-relaxed whitespace-pre-line">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <!-- Access map placeholder -->
        <div class="mt-8 rounded-lg overflow-hidden relative h-44"
          style="background: rgba(201,168,76,0.04); border: 1px solid rgba(201,168,76,0.1);">
          <img
            src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=800&q=80&auto=format&fit=crop"
            alt="Tokyo"
            class="w-full h-full object-cover opacity-40"
          />
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2">
            <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <p class="text-gold/70 text-xs tracking-wider">東京都豊島区東池袋</p>
            <p class="text-white/30 text-xs">池袋駅 徒歩5分</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
