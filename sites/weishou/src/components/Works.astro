---
const works = [
  { cat: '内装', title: 'オフィスリノベーション', sub: '東京都内・IT企業' },
  { cat: '内装', title: '飲食店舗内装施工', sub: '東京都内・カフェ' },
  { cat: 'IT', title: '業務管理システム開発', sub: '製造業向けWebシステム' },
  { cat: '内装', title: 'マンション居室リフォーム', sub: '住宅リノベーション' },
  { cat: 'IT', title: 'スマートフォンアプリ開発', sub: 'サービス業向けアプリ' },
  { cat: '内装', title: 'クリニック内装工事', sub: '医療施設・清潔感重視' },
];
---
<section id="works" class="py-24 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 fade-up">
      <span class="section-label mb-3 block">WORKS</span>
      <h2 class="text-3xl md:text-4xl font-black text-ink mb-4">施工・開発事例</h2>
      <p class="text-gray-500 text-sm">内装・IT両分野での実績の一部をご紹介します。</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {works.map((w, i) => (
        <div class="fade-up bg-white rounded-lg overflow-hidden border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group"
          style={`transition-delay: ${i * 80}ms`}>
          <!-- Placeholder visual -->
          <div class={`h-40 flex items-center justify-center ${w.cat === '内装' ? 'bg-craft/5' : 'bg-ink/5'}`}>
            {w.cat === '内装' ? (
              <svg class="w-16 h-16 text-craft/30" fill="none" stroke="currentColor" stroke-width="0.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/>
              </svg>
            ) : (
              <svg class="w-16 h-16 text-ink/20" fill="none" stroke="currentColor" stroke-width="0.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>
              </svg>
            )}
          </div>
          <div class="p-5">
            <span class={`inline-block px-2 py-0.5 text-xs font-bold rounded mb-2 ${w.cat === '内装' ? 'bg-craft/10 text-craft' : 'bg-ink/10 text-ink'}`}>
              {w.cat}
            </span>
            <h4 class="text-ink font-bold text-sm mb-1">{w.title}</h4>
            <p class="text-gray-400 text-xs">{w.sub}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
