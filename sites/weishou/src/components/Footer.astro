<footer class="bg-black border-t border-white/5 py-10 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="微匠合同会社" class="h-8 w-auto" />
      <span class="text-white/30 text-xs">微匠合同会社</span>
    </div>
    <nav class="flex gap-6">
      {[['事業内容','#services'],['施工事例','#works'],['会社概要','#about'],['お問い合わせ','#contact']].map(([label,href]) => (
        <a href={href} class="text-white/30 hover:text-craft text-xs transition-colors">{label}</a>
      ))}
    </nav>
    <p class="text-white/20 text-xs">© 2025 微匠合同会社. All Rights Reserved.</p>
  </div>
</footer>
