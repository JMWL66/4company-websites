---
---
<section id="contact" class="py-24 px-6 bg-ink">
  <!-- Red accent bar top -->
  <div class="w-full h-1 bg-craft absolute top-0 left-0" aria-hidden="true"></div>

  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 fade-up">
      <span class="text-craft text-xs tracking-widest font-medium uppercase mb-3 block">CONTACT</span>
      <h2 class="text-3xl md:text-4xl font-black text-white mb-4">お問い合わせ・お見積り</h2>
      <p class="text-white/40 text-sm">内装工事・IT開発、どちらでもお気軽にご相談ください。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10 fade-up">
      <div class="rounded-lg p-5 flex items-center gap-4"
        style="background: rgba(204,17,17,0.1); border: 1px solid rgba(204,17,17,0.2);">
        <svg class="w-5 h-5 text-craft flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
        </svg>
        <div>
          <p class="text-craft text-xs mb-0.5">電話番号</p>
          <a href="tel:0358296251" class="text-white font-bold hover:text-craft transition-colors">03-5829-6251</a>
        </div>
      </div>
      <div class="rounded-lg p-5 flex items-center gap-4"
        style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
        <svg class="w-5 h-5 text-white/50 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
        </svg>
        <div>
          <p class="text-white/40 text-xs mb-0.5">所在地</p>
          <p class="text-white/80 text-sm">東京都千代田区東神田1-3-2</p>
        </div>
      </div>
    </div>

    <form class="fade-up space-y-4"
      action="mailto:weishou@example.com" method="get" enctype="text/plain">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-white/50 text-xs font-medium mb-2">お名前 *</label>
          <input type="text" name="name" required
            class="w-full bg-ink-700 border border-white/10 text-white text-sm px-4 py-3 focus:border-craft/50 focus:outline-none transition-colors"
            placeholder="山田 太郎" />
        </div>
        <div>
          <label class="block text-white/50 text-xs font-medium mb-2">電話番号</label>
          <input type="tel" name="phone"
            class="w-full bg-ink-700 border border-white/10 text-white text-sm px-4 py-3 focus:border-craft/50 focus:outline-none transition-colors"
            placeholder="03-xxxx-xxxx" />
        </div>
      </div>
      <div>
        <label class="block text-white/50 text-xs font-medium mb-2">ご依頼の種別</label>
        <select name="type"
          class="w-full bg-ink-700 border border-white/10 text-white text-sm px-4 py-3 focus:border-craft/50 focus:outline-none transition-colors">
          <option value="">選択してください</option>
          <option value="interior">内装工事</option>
          <option value="it">ITソリューション</option>
          <option value="both">内装 + IT 両方</option>
          <option value="other">その他</option>
        </select>
      </div>
      <div>
        <label class="block text-white/50 text-xs font-medium mb-2">お問い合わせ内容 *</label>
        <textarea name="body" rows="5" required
          class="w-full bg-ink-700 border border-white/10 text-white text-sm px-4 py-3 focus:border-craft/50 focus:outline-none transition-colors resize-none"
          placeholder="内容・場所・ご予算などをお聞かせください"></textarea>
      </div>
      <button type="submit" class="btn-craft w-full py-4 text-sm font-bold">
        送 信
      </button>
    </form>
  </div>
</section>
