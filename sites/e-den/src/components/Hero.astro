---
---
<section id="home" class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <!-- Background image with dark overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1593941707882-a5bba14938c7?w=1920&q=80&auto=format&fit=crop"
      alt="EV Charging Station"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(0,20,50,0.92) 0%, rgba(0,50,30,0.85) 100%);"></div>
  </div>

  <!-- Animated dot grid overlay -->
  <div class="absolute inset-0 z-[1] opacity-10"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.6) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <!-- Animated glow circles -->
  <div class="absolute top-1/3 right-1/4 w-96 h-96 rounded-full opacity-10 z-[1]"
    style="background: radial-gradient(circle, #00E5FF, transparent 70%); animation: glow 5s ease-in-out infinite;"></div>
  <div class="absolute bottom-1/4 left-1/4 w-64 h-64 rounded-full opacity-8 z-[1]"
    style="background: radial-gradient(circle, #00CC66, transparent 70%); animation: glow 5s ease-in-out infinite 2.5s;"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <!-- Left content -->
    <div>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border mb-8"
        style="background: rgba(0,229,255,0.08); border-color: rgba(0,229,255,0.25);">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-cyan text-xs tracking-wider font-medium">GREEN ENERGY × SMART TECHNOLOGY</span>
      </div>

      <h1 class="font-sans text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight mb-6">
        グリーンエネルギーで、<br />
        <span class="gradient-text">未来を充電する。</span>
      </h1>

      <p class="text-white/60 text-base font-light leading-relaxed mb-4 max-w-lg">
        スマート充電技術とIoTソリューションにより、<br class="hidden sm:block"/>
        持続可能な低炭素社会の実現に貢献します。
      </p>
      <p class="text-white/40 text-sm font-light leading-relaxed mb-10 max-w-lg">
        「革新と前進」の精神で、充電インフラの未来を切り拓きます。
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#services" class="btn-primary px-8 py-4">事業内容を見る</a>
        <a href="#contact" class="btn-outline px-8 py-4">お問い合わせ</a>
      </div>

      <!-- SDGs badge -->
      <div class="mt-10 flex items-center gap-3">
        <div class="flex gap-2">
          {['SDGs', 'カーボンニュートラル', 'EV推進'].map(tag => (
            <span class="px-3 py-1 text-xs rounded-full font-medium text-accent"
              style="background: rgba(0,204,102,0.12); border: 1px solid rgba(0,204,102,0.25);">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: stats grid -->
    <div class="grid grid-cols-2 gap-4">
      {[
        { num: '8+', label: '事業領域', sub: 'Business areas', icon: '⚡' },
        { num: 'IoT', label: 'スマートシステム', sub: 'Connected infrastructure', icon: '🌐' },
        { num: 'EV', label: '充電インフラ', sub: 'Charging network', icon: '🔋' },
        { num: '2025', label: '設立', sub: '新しい未来へ', icon: '🚀' },
      ].map((stat) => (
        <div class="rounded-xl p-6 group hover:scale-105 transition-transform duration-300"
          style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(8px);">
          <div class="text-2xl mb-2">{stat.icon}</div>
          <p class="text-3xl font-bold gradient-text mb-1">{stat.num}</p>
          <p class="text-white text-sm font-medium">{stat.label}</p>
          <p class="text-white/40 text-xs mt-0.5">{stat.sub}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40 z-10">
    <div class="w-px h-10 bg-gradient-to-b from-white to-transparent"></div>
    <span class="text-white/60 text-[10px] tracking-widest">SCROLL</span>
  </div>

  <style>
    @keyframes glow {
      0%, 100% { transform: scale(1); opacity: 0.08; }
      50% { transform: scale(1.3); opacity: 0.14; }
    }
  </style>
</section>
