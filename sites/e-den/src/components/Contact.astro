---
---
<section id="contact" class="py-24 px-6 bg-surface">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12 fade-up">
      <span class="section-label mb-3 block">CONTACT</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">お問い合わせ</h2>
      <p class="text-gray-500 text-sm">ご用件・ご質問などお気軽にお問い合わせください。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 fade-up">
      {[
        {
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>`,
          label: '所在地',
          value: '東京都千代田区東神田1-3-2\nBIGS東神田3F',
        },
        {
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>`,
          label: '電話番号',
          value: '080-3726-2723',
        },
        {
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>`,
          label: 'メール',
          value: 'edian3399@gmail.com',
        },
      ].map((info) => (
        <div class="bg-white rounded-lg p-6 text-center border border-gray-100">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary/10 text-primary mb-3">
            <Fragment set:html={info.icon} />
          </div>
          <p class="text-gray-400 text-xs mb-1">{info.label}</p>
          <p class="text-gray-700 text-sm font-medium whitespace-pre-line">{info.value}</p>
        </div>
      ))}
    </div>

    <form class="fade-up bg-white rounded-lg p-8 border border-gray-100 grid grid-cols-1 md:grid-cols-2 gap-6"
      action="mailto:edian3399@gmail.com" method="get" enctype="text/plain">
      <div>
        <label class="block text-gray-600 text-xs font-medium mb-2">お名前 *</label>
        <input type="text" name="name" required
          class="w-full border border-gray-200 rounded-sm px-4 py-3 text-sm text-gray-900 focus:outline-none focus:border-primary transition-colors"
          placeholder="山田 太郎" />
      </div>
      <div>
        <label class="block text-gray-600 text-xs font-medium mb-2">メールアドレス *</label>
        <input type="email" name="email" required
          class="w-full border border-gray-200 rounded-sm px-4 py-3 text-sm text-gray-900 focus:outline-none focus:border-primary transition-colors"
          placeholder="example@email.com" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-gray-600 text-xs font-medium mb-2">件名</label>
        <input type="text" name="subject"
          class="w-full border border-gray-200 rounded-sm px-4 py-3 text-sm text-gray-900 focus:outline-none focus:border-primary transition-colors"
          placeholder="お問い合わせ件名" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-gray-600 text-xs font-medium mb-2">お問い合わせ内容 *</label>
        <textarea name="body" rows="5" required
          class="w-full border border-gray-200 rounded-sm px-4 py-3 text-sm text-gray-900 focus:outline-none focus:border-primary transition-colors resize-none"
          placeholder="お問い合わせ内容をご記入ください"></textarea>
      </div>
      <div class="md:col-span-2">
        <button type="submit" class="btn-primary w-full py-4 text-sm font-semibold">送 信</button>
      </div>
    </form>
  </div>
</section>
