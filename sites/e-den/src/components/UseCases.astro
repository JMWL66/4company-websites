---
const cases = [
  {
    img: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80&auto=format&fit=crop',
    tag: 'モビリティ',
    title: 'EV充電インフラ',
    desc: '商業施設・駐車場・マンションへのEV充電ステーション設置・運用をワンストップで提供。IoT管理システムにより、リアルタイム稼働状況の把握と最適制御を実現します。',
  },
  {
    img: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&q=80&auto=format&fit=crop',
    tag: 'スマート管理',
    title: 'IoTプラットフォーム',
    desc: '充電設備の稼働データをクラウドで一元管理。AIによる需要予測と自動メンテナンスアラートにより、運用コストの大幅削減と安定稼働を実現します。',
  },
  {
    img: 'https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=800&q=80&auto=format&fit=crop',
    tag: 'グリーンエネルギー',
    title: '再生可能エネルギー連携',
    desc: '太陽光・風力発電との連携により、充電電力の再エネ化を推進。カーボンニュートラルな充電インフラの構築で、企業のESG目標達成を支援します。',
  },
];
---
<section class="py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 fade-up">
      <span class="section-label mb-3 block">USE CASES</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">利用シーン</h2>
      <p class="text-gray-500 text-sm max-w-xl mx-auto">
        様々な業界・シーンで活用されるE電のソリューション
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {cases.map((c, i) => (
        <div class="fade-up rounded-xl overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
          style={`transition-delay: ${i * 100}ms`}>
          <div class="relative h-52 overflow-hidden">
            <img src={c.img} alt={c.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>
            <span class="absolute top-4 left-4 px-3 py-1 text-xs font-bold text-white rounded-full"
              style="background: rgba(0,136,204,0.8); backdrop-filter: blur(4px);">
              {c.tag}
            </span>
          </div>
          <div class="p-6">
            <h3 class="text-gray-900 font-bold text-lg mb-3">{c.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{c.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
